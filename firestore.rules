rules_version = '2';
// Règles de la base du jumeau numérique du bâtiment.
// À coller dans Firebase → Firestore Database → Règles, puis « Publier ».
// Accès ouvert (comme les autres applis) : toute personne ayant le lien du site peut lire et modifier.
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{id}   { allow read, write: if true; }
    match /racks/{id}    { allow read, write: if true; }
    match /items/{id}    { allow read, write: if true; }
    match /visites/{id}  { allow read, write: if true; }
    match /personnes/{id} {
      allow read: if true;
      allow write: if request.resource == null || (request.resource.data.nom is string && request.resource.data.nom.size() <= 40);
    }
  }
}
